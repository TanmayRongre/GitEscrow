# GitEscrow Environment Configuration (.env)
# Copy this file to server/.env and root .env

# PayPal Sandbox Configuration
# Create a REST API app under PayPal Developer Dashboard -> Sandbox -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Target Sandbox personal account to receive test payouts (used with --run-payout)
PAYPAL_SANDBOX_CONTRIBUTOR_EMAIL=sb-contributor@personal.example.com

# GitHub API Configuration
# Fine-grained Personal Access Token with Read permissions for:
# Repository metadata, Issues, Pull requests, Contents, Checks
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_API_BASE_URL=https://api.github.com

# Test Repository for GitHub Integration Verification
# Specify a real repository and issue/PR you have access to, or a public repository for testing
GITHUB_TEST_OWNER=facebook
GITHUB_TEST_REPO=react
GITHUB_TEST_ISSUE_NUMBER=1
GITHUB_TEST_PR_NUMBER=2

# JWT Authentication & RBAC Configuration (Task 2A)
# Generate cryptographically secure random secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_bytes_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_bytes_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_SETUP_SECRET=your_one_time_admin_bootstrap_secret_here

# Frontend Application URL (for CORS and cookie origin)
FRONTEND_URL=http://localhost:5173

# MongoDB Database Configuration
# Local MongoDB instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/gitescrow

# Express Server Port
PORT=5000
