# ==============================================================================
# GitEscrow Environment Configuration Template (.env.example)
# Copy this file to .env and server/.env
# cp .env.example .env && cp .env.example server/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Ports
# ------------------------------------------------------------------------------
# Express backend port (default: 5000)
PORT=5000

# Node execution environment ('development', 'production', or 'test')
NODE_ENV=development

# Frontend application URL (used for CORS origin whitelist and cookie domain matching)
FRONTEND_URL=http://localhost:5173

# Frontend client API proxy URL (used by Vite client, default: /api)
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 2. MongoDB Database Configuration
# ------------------------------------------------------------------------------
# Connection URI for MongoDB Atlas cluster or local MongoDB instance
# Local: mongodb://localhost:27017/gitescrow
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gitescrow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gitescrow

# ------------------------------------------------------------------------------
# 3. Authentication & RBAC (JWT & Admin Setup)
# ------------------------------------------------------------------------------
# Cryptographically secure random strings (minimum 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_bytes_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_bytes_here

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# One-time admin setup secret to bootstrap the initial ADMIN account
# Endpoint: POST /api/auth/setup-admin
ADMIN_SETUP_SECRET=your_one_time_admin_bootstrap_secret_here

# ------------------------------------------------------------------------------
# 4. PayPal Sandbox Configuration
# ------------------------------------------------------------------------------
# Obtain from PayPal Developer Dashboard -> Sandbox -> Apps & Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Sandbox API endpoint (use https://api-m.sandbox.paypal.com for testing)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Registered PayPal Sandbox Webhook ID (used for signature verification)
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Target Sandbox personal account email to receive test payouts (used with --run-payout)
PAYPAL_SANDBOX_CONTRIBUTOR_EMAIL=sb-contributor@personal.example.com

# ------------------------------------------------------------------------------
# 5. GitHub API & Webhook Configuration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained) with read access to issues and PRs
# Strongly recommended to avoid public unauthenticated rate limits (60 req/hr vs 5,000 req/hr)
GITHUB_TOKEN=ghp_your_github_token_here

# Timing-safe HMAC SHA-256 webhook secret for incoming GitHub events
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub REST API base URL (default: https://api.github.com)
GITHUB_API_BASE_URL=https://api.github.com

# Real repository fixtures for automated integration and regression testing
GITHUB_TEST_OWNER=facebook
GITHUB_TEST_REPO=react
GITHUB_TEST_ISSUE_NUMBER=38090
GITHUB_TEST_PR_NUMBER=38090

# ------------------------------------------------------------------------------
# 6. AI Provider Configuration (Multi-Provider LLM Integration)
# ------------------------------------------------------------------------------
# GitEscrow supports Gemini 2.0 (Google) and OpenAI GPT models.
# If omitted or unconfigured, GitEscrow transparently falls back to its deterministic
# AST & Semantic Fallback Analyzer with 100% test passing and zero crashes.
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative Google API key variable name recognized by client
GOOGLE_API_KEY=your_google_api_key_here
# OpenAI API key (optional fallback or alternative)
OPENAI_API_KEY=your_openai_api_key_here
